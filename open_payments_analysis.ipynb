    "    \"Nature_of_Payment_or_Transfer_of_Value\",\n",
    "    \"Total_Amount_of_Payment_USDollars\",\n",
    "    \"Date_of_Payment\"\n",
    "]\n",
    "\n",
    "df = df[needed_columns].copy()\n",
